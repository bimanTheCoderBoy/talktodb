{
  "site_preview": {
    "site_iid":  { "excel": "Property: ID",                             "transform": "str" },
    "latitude":  { "excel": "Property: Location: Y Coordinate",         "transform": "float" },
    "longitude": { "excel": "Property: Location: X Coordinate",         "transform": "float" }
  },

  "root": {
    "iid":       { "excel": "Property: ID",                             "source": "first_row", "transform": "str" },
    "address1":  { "excel": "Property: Address 1",                      "source": "first_row", "transform": "str" },
    "town":      { "excel": "Property:  Town",                          "source": "first_row", "transform": "str" },
    "state":     { "excel": "Property: State",                          "source": "first_row", "transform": "str" },
    "longitude": { "excel": "Property: Location: X Coordinate",         "source": "first_row", "transform": "float" },
    "latitude":  { "excel": "Property: Location: Y Coordinate",         "source": "first_row", "transform": "float" },
    "epsg":      { "excel": "Property: Location: EPSG",                 "source": "first_row", "transform": "int" }
  },

  "physicalAntennas": {
    "antennaDevice.iid":    { "excel": "Property: Physical Antenna: Antenna Device",             "source": "per_row", "transform": "split_backslash" },
    "masterPattern1.iid":   { "excel": "Property: Logical Antenna: Pattern",                     "source": "per_row", "transform": "str" },
    "absLocation.longitude":{ "excel": "Property: Location: X Coordinate",                       "source": "per_row", "transform": "float" },
    "absLocation.latitude": { "excel": "Property: Location: Y Coordinate",                       "source": "per_row", "transform": "float" },
    "absLocation.epsg":     { "excel": "Property: Location: EPSG",                               "source": "per_row", "transform": "int" },
    "azimuth":              { "excel": "Property: Physical Antenna: Azimuth (deg)",               "source": "per_row", "transform": "float" },
    "tilt":                 { "excel": "Property: Physical Antenna: Mechanical Down Tilt (deg)",  "source": "per_row", "transform": "float" },
    "height":               { "excel": "Property: Physical Antenna: Height - Inventory (m)",      "source": "per_row", "transform": "float" },
    "index":                { "excel": "Property: Physical Antenna: Index",                       "source": "per_row", "transform": "int" }
  },

  "logicalAntennas": {
    "primaryModel.modelType.iid": { "excel": "Property: Logical Antenna: Primary Prediction: Model",          "source": "per_row", "transform": "str" },
    "primaryModel.radiusKM":      { "excel": "Property: Logical Antenna: Primary Prediction: Radius (km)",    "source": "per_row", "transform": "float" },
    "primaryModel.resolutionMetres": { "excel": "Property: Logical Antenna: Primary Prediction: Resolution (m)", "source": "per_row", "transform": "float" },
    "phyindex":                   { "excel": "Property: Physical Antenna: Index",                               "source": "per_row", "transform": "int" },
    "index":                      { "excel": "Property: Logical Antenna: Index",                                "source": "per_row", "transform": "int" },
    "beamSet.iid":                { "excel": "Cell: BeamSet",                                                   "source": "per_row", "transform": "str" }
  },

  "beamSwitching": {
    "patternFrequency": { "excel": "NR BeampatternFrequency", "transform": "int" },
    "patternName":      { "excel": "Property: Logical Antenna: Pattern", "transform": "str" },
    "gain":             { "excel": "NR BeampatternGain",      "transform": "float" },
    "electricalTilt":   { "excel": "NR BeampatternETilt",     "transform": "float" },
    "antennaPatternAngle": { "excel": "NR BeampatternAngle",  "transform": "float" }
  }
}
